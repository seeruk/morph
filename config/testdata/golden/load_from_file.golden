{
  "defaults": {
    "packages": {
      "types": {
        "enum": {
          "failureMode": "error"
        },
        "mappers": {
          "forward": {
            "name": "Map{{ .Source.Type }}To{{ .Target.Type }}",
            "signature": {
              "accepts": "value",
              "returns": "pointer"
            }
          },
          "inverse": {
            "name": "Map{{ .Target.Type }}To{{ .Source.Type }}",
            "signature": {
              "accepts": "pointer",
              "returns": "value"
            }
          }
        },
        "optionality": null,
        "bidirectional": true
      },
      "output": {
        "strategy": "single_package",
        "path": "internal/mapping",
        "package": "mapping",
        "filename": "mapping.morph.go"
      }
    }
  },
  "discovery": {
    "packages": [
      "module.test/shared/conversions"
    ],
    "functions": [
      "module.test/shared/conversions.CheckedIntToSmallInt",
      "module.test/shared/conversions.UserID.String"
    ],
    "exclusions": [
      "module.test/shared/conversions.LegacyUserToUser",
      "module.test/shared/conversions.LegacyStatus.ToStatus"
    ]
  },
  "packages": [
    {
      "source": "module.test/source",
      "target": "module.test/target",
      "preset": "api",
      "types": [
        {
          "name": "User",
          "source": "",
          "target": "",
          "preset": "",
          "enum": null,
          "struct": {
            "fields": {
              "DisplayName": {
                "target": "Name",
                "optionality": null
              },
              "ID": {
                "target": "UserID",
                "optionality": null
              }
            }
          },
          "mappers": {
            "forward": {
              "name": "MapSourceUserToTargetUser",
              "signature": {
                "accepts": "pointer",
                "returns": "value"
              }
            },
            "inverse": {
              "name": "MapTargetUserToSourceUser",
              "signature": {
                "accepts": "value",
                "returns": "pointer"
              }
            }
          },
          "optionality": null,
          "bidirectional": null
        },
        {
          "name": "",
          "source": "SourceStatus",
          "target": "TargetStatus",
          "preset": "",
          "enum": {
            "failureMode": "zero",
            "patterns": {
              "source": "SourceStatus_\u003cSCREAMING_VALUE\u003e",
              "target": "TargetStatus\u003cPascalValue\u003e"
            },
            "values": {
              "SourceStatus_ACTIVE": "TargetStatusActive",
              "SourceStatus_UNKNOWN": "TargetStatusUnknown"
            }
          },
          "struct": null,
          "mappers": null,
          "optionality": null,
          "bidirectional": null
        }
      ],
      "output": {
        "strategy": null,
        "path": "",
        "package": "",
        "filename": ""
      },
      "enum": null,
      "mappers": null,
      "optionality": null,
      "bidirectional": true
    },
    {
      "source": "module.test/database",
      "target": "module.test/domain",
      "preset": "",
      "types": [
        {
          "name": "AuditLog",
          "source": "",
          "target": "",
          "preset": "",
          "enum": null,
          "struct": null,
          "mappers": null,
          "optionality": null,
          "bidirectional": null
        },
        {
          "name": "",
          "source": "DBRole",
          "target": "Role",
          "preset": "",
          "enum": {
            "failureMode": "error",
            "patterns": null,
            "values": {
              "DBRoleAdmin": "RoleAdmin"
            }
          },
          "struct": null,
          "mappers": null,
          "optionality": null,
          "bidirectional": null
        }
      ],
      "output": {
        "strategy": null,
        "path": "",
        "package": "",
        "filename": ""
      },
      "enum": null,
      "mappers": null,
      "optionality": null,
      "bidirectional": null
    }
  ],
  "presets": {
    "api": {
      "enum": {
        "failureMode": "error"
      },
      "mappers": {
        "forward": {
          "name": "Map{{ .Target.Package }}{{ .Target.Type }}FromAPI",
          "signature": {
            "accepts": "pointer",
            "returns": "value"
          }
        },
        "inverse": {
          "name": "Map{{ .Target.Package}}{{ .Target.Type }}ToAPI",
          "signature": {
            "accepts": "value",
            "returns": "pointer"
          }
        }
      },
      "optionality": null,
      "bidirectional": true
    }
  }
}